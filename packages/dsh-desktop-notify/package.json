{
  "name": "@lixklv/dsh-desktop-notify",
  "version": "0.0.1",
  "description": "DSH Desktop 原生通知：回合结束、等待人工选择、等待授权时弹 macOS 系统通知。经 DSH Desktop 主二进制以 io.dsh.desktop 身份投递，通知显示为 DSH Desktop 本身，无需安装任何外部组件。",
  "author": "lixklv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YS-BW/dsh-plugins.git",
    "directory": "packages/dsh-desktop-notify"
  },
  "homepage": "https://github.com/YS-BW/dsh-plugins/tree/main/packages/dsh-desktop-notify#readme",
  "bugs": {
    "url": "https://github.com/YS-BW/dsh-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build": "tsdown && tsc -p tsconfig.build.json && node scripts/build-native.mjs",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-web",
    "deepseek-harness"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.2",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
