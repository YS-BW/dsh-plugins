{
  "name": "@lixklv/dsh-hello",
  "version": "0.0.1",
  "description": "Minimal DSH Web GUI plugin skeleton: a floating badge that proves the host/client bundle pipeline end to end.",
  "author": "lixklv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YS-BW/dsh-plugins.git",
    "directory": "packages/dsh-hello"
  },
  "homepage": "https://github.com/YS-BW/dsh-plugins/tree/main/packages/dsh-hello#readme",
  "bugs": {
    "url": "https://github.com/YS-BW/dsh-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-web",
    "deepseek-harness"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
